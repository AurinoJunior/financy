# Postgres (docker-compose)
POSTGRES_USER=financy
POSTGRES_PASSWORD=financy
POSTGRES_DB=financy
POSTGRES_PORT=5432

# Connection string usada pela app / Drizzle
DATABASE_URL=postgresql://financy:financy@localhost:5432/financy

# OpenRouter (categorização por IA) — preenchido na Fase 4
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Better Auth — preenchido na Fase 1
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
